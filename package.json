{
  "dependencies": {
    "@iconify/react": "^6.0.4",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@solar-icons/react": "2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.35.2",
    "tailwind-merge": "^3.4.0",
    "vaul": "^1.1.2"
  },
  "description": "Junction \u2014 the shared design system powering the digital products and experiences built by LifeatJNTUH. Colours, type and components from the @lifeatjntuh website design system.",
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "exports": {
    ".": {
      "import": "./dist/junction.js",
      "require": "./dist/junction.cjs",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json",
    "./theme": "./dist/style.css",
    "./tokens": {
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs",
      "types": "./dist/types/tokens.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/junction.cjs",
  "module": "./dist/junction.js",
  "name": "@lifeatjntuh/junction",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "blobmates": {
      "optional": true
    }
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:demo": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "dev": "vite",
    "docs:build": "npm --prefix docs run build",
    "docs:dev": "npm --prefix docs run start",
    "lint": "tsc --noEmit",
    "prepack": "npm run build:lib",
    "preview": "vite preview --port 4173"
  },
  "sideEffects": [
    "*.css"
  ],
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "0.1.0"
}
